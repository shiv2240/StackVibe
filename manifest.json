{
  "manifest_version": 3,
  "name": "StackVibe - Tech Stack & Design Spec Extractor",
  "version": "2.0.0",
  "description": "Identify 100% accurate frontend tech stacks, WordPress plugins/themes, CMS, analytics, CDN infrastructure, and extract complete getdesign.md design systems, 6-level DOM hierarchy trees, component blueprints, AI prompts, Figma tokens, and multi-criteria inspiration lab.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StackVibe Developer Console",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/tech_signatures.js",
        "content/main_world_detector.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/tech_signatures.js",
        "content/detector.js",
        "content/design_extractor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "content/main_world_detector.js", "content/inspector_overlay.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
